# Store endpoints are no longer configured here: they are stored per store in the
# `store` table, seeded from solution/config/stores.yaml at onboarding time.

# Running the app on the host (stores reachable on the compose-published ports):
DATABASE_URL=mysql+pymysql://dev:abcdef123@127.0.0.1:33063/app_db
API_URL=http://localhost:8000

# Inside docker compose, the backend container gets DATABASE_URL from
# docker-compose.yml and the store endpoints come from config/stores.docker.yaml.
