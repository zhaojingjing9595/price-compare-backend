# Inside docker compose:
DATABASE_URL=mysql+pymysql://dev:abcdef123@mysql_db:3306/app_db

# ebay-server is published on 8300 and amazon-server on 8301
EBAY_URL=http://ebay-server:9991
AMAZON_URL=http://amazon-server:9991

# Running the app on the host instead of in compose:
# DATABASE_URL=mysql+pymysql://user:password@mysql_db:3306/app_db
# EBAY_URL=http://localhost:8300
# AMAZON_URL=http://localhost:8301